# Local development only. Generate separate random passwords; never deploy these placeholders.
POSTGRES_PASSWORD=replace-with-random-admin-password
APP_DATABASE_PASSWORD=replace-with-random-runtime-password
ADMIN_DATABASE_URL=postgresql://superagent_admin:replace-with-random-admin-password@127.0.0.1:5433/superagent
DATABASE_URL=postgresql://superagent_app:replace-with-random-runtime-password@127.0.0.1:5433/superagent
PORT=3000
BUILDER_AI_ENABLED=false
BUILDER_AI_MODEL=gpt-4.1-mini
# Optional comma-separated model IDs shown in the frontend. Must include BUILDER_AI_MODEL.
BUILDER_AI_MODELS=gpt-4.1-mini,gpt-4.1
OPENAI_API_KEY=
# Optional public MCP reference servers. Tool names must be reviewed as read-only.
# Example: [{"label":"openai_docs","url":"https://developers.openai.com/mcp","tools":["search_openai_docs"]}]
BUILDER_MCP_SERVERS_JSON=[]
# Optional dedicated worker login. Set a separate random password (at least 24 characters), then rerun migrations.
BUILDER_WORKER_DATABASE_PASSWORD=
BUILDER_WORKER_DATABASE_URL=
# Optional Google connection setup. Register the exact callback URL as a Web application OAuth redirect.
# The trusted client callback posts code/state to the authenticated completion API; no callback page is included yet.
GOOGLE_CONNECTIONS_ENABLED=false
SHEETS_DELIVERY_ENABLED=false
# Separate opt-in worker process. Provision this non-owner login by setting its password and rerunning migrations.
SHEETS_WORKER_ENABLED=false
SHEETS_WORKER_DATABASE_PASSWORD=
SHEETS_WORKER_DATABASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# JSON map of key IDs to random 32-byte base64 keys. Keep previous keys during rotation. Never commit real values.
CREDENTIAL_ACTIVE_KEY_ID=
CREDENTIAL_KEYS_JSON=
# Optional WhatsApp Cloud API intake. Secrets must be at least 16 characters.
# Point the Meta webhook at /v1/webhooks/whatsapp over HTTPS.
WHATSAPP_ENABLED=false
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Runs queued WhatsApp workflow executions inside the API process. Requires migrations 013-014.
WORKFLOW_RUNNER_ENABLED=false
# Outbound WhatsApp replies. A Meta system-user token with whatsapp_business_messaging; unset = replies stay queued.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
