# Local development only. Generate separate random passwords; never deploy these placeholders.
POSTGRES_PASSWORD=replace-with-random-admin-password
APP_DATABASE_PASSWORD=replace-with-random-runtime-password
ADMIN_DATABASE_URL=postgresql://superagent_admin:replace-with-random-admin-password@127.0.0.1:5433/superagent
DATABASE_URL=postgresql://superagent_app:replace-with-random-runtime-password@127.0.0.1:5433/superagent
PORT=3000
BUILDER_AI_ENABLED=false
BUILDER_AI_MODEL=
OPENAI_API_KEY=
# Optional dedicated worker login. Set a separate random password (at least 24 characters), then rerun migrations.
BUILDER_WORKER_DATABASE_PASSWORD=
BUILDER_WORKER_DATABASE_URL=
# Optional Google connection setup. Register the exact callback URL as a Web application OAuth redirect.
# The trusted client callback posts code/state to the authenticated completion API; no callback page is included yet.
GOOGLE_CONNECTIONS_ENABLED=false
SHEETS_DELIVERY_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# JSON map of key IDs to random 32-byte base64 keys. Keep previous keys during rotation. Never commit real values.
CREDENTIAL_ACTIVE_KEY_ID=
CREDENTIAL_KEYS_JSON=
