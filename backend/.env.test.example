# Separate disposable database; use the same local database-role passwords as backend/.env.
APP_DATABASE_PASSWORD=replace-with-random-runtime-password
ADMIN_DATABASE_URL=postgresql://superagent_admin:replace-with-random-admin-password@127.0.0.1:5433/superagent_test
DATABASE_URL=postgresql://superagent_app:replace-with-random-runtime-password@127.0.0.1:5433/superagent_test
BUILDER_WORKER_DATABASE_PASSWORD=replace-with-random-worker-password
BUILDER_WORKER_DATABASE_URL=postgresql://superagent_builder_worker:replace-with-random-worker-password@127.0.0.1:5433/superagent_test
# Dedicated Sheets worker login for the same isolated test database; use the same role password as local migrations.
SHEETS_WORKER_DATABASE_PASSWORD=replace-with-random-sheets-worker-password
SHEETS_WORKER_DATABASE_URL=postgresql://superagent_sheet_worker:replace-with-random-sheets-worker-password@127.0.0.1:5433/superagent_test
